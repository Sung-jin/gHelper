# --- OS Specific ---
.DS_Store
Thumbs.db
*.swp

# --- IDEs (IntelliJ, VS Code) ---
.idea/
.vscode/
*.iml
*.iws
*.ipr
out/

# --- Node.js (Frontend / Electron) ---
node_modules/
dist/
dist-electron/
release/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python (Engine) ---
# 가상환경 폴더 (OS간 호환이 안 되므로 제외)
engine/venv/
engine/.venv/

# Python 컴파일 파일
__pycache__/
*.py[cod]
*$py.class
*.pyc

# --- Project Specific (Output Files) ---
# 모니터링 결과로 생성되는 로그 파일들
packet_dump_*.txt
packet_log.txt

# 빌드 결과물 파일들 (.exe, .dmg, .zip 등)
*.exe
*.dmg
*.zip
*.AppImage

# PyInstaller 빌드 관련
build/
*.spec

# --- 라벨링 샘플 (백데이터, 선택 관리) ---
# GitHub에는 코드·문서만 올리고 샘플은 로컬/별도 백업 권장. 필요 시 아래 줄 삭제.
engine/tools/analyze/
